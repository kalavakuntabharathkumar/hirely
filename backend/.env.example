# Copy this file to .env (inside backend/) and edit the values below.
# .env is private and must never be committed.

# REQUIRED. Long random text. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# development or production. Production turns on Secure cookies (needs HTTPS).
HIRELY_ENV=development

# DATABASE_URL=sqlite:///C:/full/path/hirely.db   (optional; default is backend/hirely.db)

# Demo login created by "python -m app.seed". REQUIRED to seed. Pick your own password.
DEMO_EMAIL=demo@hirely.test
DEMO_PASSWORD=change-me-too

# Session lifetime in days
SESSION_DAYS=7
